-- Writes dist/nimbus-setup.lua: one self-extracting file with all of Nimbus inside, for
-- worlds where HTTP is off. Run from the project root, after build/manifest.luau:
--   lune run build/bundle.luau
local fs = require("@lune/fs")
local serde = require("@lune/serde")

local BUDGET = 300 * 1024 -- a computer holds 1 MB by default; leave most of it for the player

local manifest = serde.decode("json", fs.readFile("build/manifest.json"))
local paths = {}
for path in manifest.files do table.insert(paths, path) end
table.sort(paths)

local parts, total = {}, 0
for _, path in paths do
	local body = fs.readFile(path)
	total += #body
	local level = 2 -- pick a long-bracket level the file itself doesn't contain
	while body:find("]" .. string.rep("=", level) .. "]", 1, true) do level += 1 end
	local eq = string.rep("=", level)
	-- a long string drops one leading newline, so one is added
	table.insert(parts, `files["{path}"] = [{eq}[\n{body}]{eq}]`)
end
assert(total <= BUDGET, `Nimbus is {total} bytes, over the {BUDGET} byte budget`)
assert(total == manifest.size, "build/manifest.json is stale: run build/manifest.luau first")

-- (Luau's interpolated strings can't span lines, so the installer is assembled from pieces.)
local version = tostring(manifest.version)
local out = table.concat({
	"-- Nimbus " .. version .. " offline installer. Generated by build/bundle.luau: edit the sources, not this file.",
	"-- Get it onto an advanced computer (drag the file onto the computer's screen) and run it.",
	"local files = {}",
	table.concat(parts, "\n"),
	"",
	'local free = fs.getFreeSpace("/")',
	'if type(free) == "number" and free < ' .. total .. " then",
	'  error("Not enough space: Nimbus needs ' .. total // 1024 .. ' KB", 0)',
	"end",
	'print("Installing Nimbus ' .. version .. '")',
	"for path, body in pairs(files) do",
	'  local f, err = fs.open(path, "wb")',
	'  if not f then error("Could not write " .. path .. ": " .. tostring(err), 0) end',
	"  f.write(body)",
	"  f.close()",
	"end",
	"pcall(fs.delete, shell.getRunningProgram()) -- unpacked: free the space this installer takes",
	'print("Nimbus is installed.")',
	'write("Restart now? (y/n) ")',
	'if read():lower() ~= "n" then os.reboot() end',
	"",
}, "\n")
if not fs.isDir("dist") then fs.writeDir("dist") end
fs.writeFile("dist/nimbus-setup.lua", out)
print(`bundle: {#paths} files, {total} bytes of Nimbus, {#out} byte installer`)
